---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MovieGrid from '../../components/MovieGrid.astro';
import KnowledgeGrid from '../../components/KnowledgeGrid.astro';
import movies from '../../data/movies.json';
import knowledge from '../../data/knowledge.json';
import EntertainmentDetail from '../../components/EntertainmentDetail.astro';
import ShortVideoGrid from '../../components/ShortVideoGrid.astro';
import { slugify } from '../../utils/slugify.js';

export function getStaticPaths() {  

	return movies.map(movie => ({
		params: { slug: slugify(movie.title) },
		props: { movie }
	}));
}

const { movie } = Astro.props;

// Filter related movies by category/genre
  let unshuffledEntertainment = movies.filter(m => m.category === movie.category && m.title !== movie.title);

  let relatedEntertainment = [...unshuffledEntertainment].sort(() => Math.random() - 0.5).slice(0,4);

  let unshuffledKnowledge = knowledge.filter(k => k.entertainment.includes(movie.title));

  let finalKnowledge = [...unshuffledKnowledge].sort(() => Math.random() - 0.5).slice(0,4);

  let unshuffledShorts = knowledge.filter(k => k.entertainment.includes(movie.title)).slice(0,4);

---

<Layout 
	title={`${movie.title} (${movie.year}) - Geekotist by Camprowe`}
	description={`Discover all Geekotist content about ${movie.title} produced by Camprowe, including general details about the ${movie.category}.`}
	image={movie.imageUrl}
	type="video.movie"
	movieData={movie}
>
	<Header />
	<main class="movie-page">
		<div class="content">
			<nav aria-label="Breadcrumb">
				<ol>
					<li><a href="../..">Home</a></li>
					<li><a href="../">Entertainment</a></li>
					<li>{movie.title}</li>
				</ol>
			</nav>
		</div>

		<EntertainmentDetail entertainment={movie} />

		{finalKnowledge.length > 0 && (
			<div class="related-section">
				<KnowledgeGrid title={"Knowledge"} knowledge={finalKnowledge} knowledgeLink={`/entertainment/${slugify(movie.title)}/knowledge`}  />
			</div>
		)}

    <!-- {unshuffledShorts.length > 0 && (
			<div class="related-section">
				<ShortVideoGrid title={"Video Shorts"} knowledge={unshuffledShorts} knowledgeLink={`/entertainment/${slugify(movie.title)}/video-shorts`}  />
			</div>
		)} -->

		{relatedEntertainment.length > 0 && (
			<div class="related-section">
				<MovieGrid title={"More " + movie.category + "s"} movies={relatedEntertainment} />
			</div>
		)}

	</main>
	<Footer />
</Layout>

<style>
  
	.movie-page {
		margin: 0 auto;
		padding-top: 8rem;
		min-height: 100vh;
	}		
 
  .btn{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    padding: 11px 18px;
    border-radius: 4px;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
 
  .btn:focus-visible{ outline: 2px solid var(--brass); outline-offset: 2px; }
  .btn:hover{ transform: translateY(-1px); }
 
  .btn-primary{
    background: var(--ember);
    color: var(--paper);
  }
  .btn-primary:hover{ background: var(--ember-hover); }
 
  .btn-secondary{
    background: transparent;
    color: var(--paper);
    border: 1px solid var(--hairline);
  }
  .btn-secondary:hover{ border-color: var(--brass); }
 
  .btn svg{ width: 12px; height: 12px; }
  
	.related-section {
		margin: 0 auto;
		padding: 2rem 0;
	}

	/* Breadcrumb */
	.content {
 		padding: 20px 32px;
	}
	
	nav ol {
	list-style: none;
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0;
	margin: 0 0 1.5rem;
	padding: 0;
	}

	nav li {
	display: flex;
	align-items: center;
	font-size: .9rem;
	}

	/* The separator sits on every item that follows another one */
	nav li + li::before {
	content: "/";
	color: #88888f;
	margin: 0 .5rem;
	}

	nav li:last-child {
	color: #000000;
	font-weight: 500;
	}

	nav a {
	color: #88888f;
	text-decoration: none;
	transition: color .15s;
	}

	nav a:hover {
	color: #FFA500;
	}

	/* Arrow variant */
	.bc-arrow li + li::before {
	content: "›";
	font-size: 1.1rem;
	line-height: 1;
	}

	/* Chevron drawn from two borders instead of a character */
	.bc-chevron li + li::before {
	content: "";
	display: inline-block;
	width: 6px;
	height: 6px;
	border-top: 1.5px solid #88888f;
	border-right: 1.5px solid #88888f;
	transform: rotate(45deg);
	margin: 0 .6rem;
	}

	/* Pill variant drops the separator and spaces the items instead */
	.bc-pill li {
	background: #1c1c1e;
	padding: .25rem .75rem;
	border-radius: 99px;
	font-size: .8rem;
	}

	.bc-pill li + li::before {
	display: none;
	}

	.bc-pill li + li {
	margin-left: .35rem;
	}

	.bc-pill li:last-child {
	background: rgba(184, 255, 87, .1);
	color: #b8ff57;
	}
</style>
