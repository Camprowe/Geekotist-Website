---
const { entertainment } = Astro.props;
---

<section class="hero">
    <div class="hero-inner">

    <div class="art">
    </div>

    <div class="content">

        <h1 class="title">{entertainment.title}</h1>

        <div class="tags">
            <span class="tag">{entertainment.category}</span>
        </div>

        <div class="meta-grid">
        <div>
            <span class="meta-label">STUDIO</span>
            <span class="meta-value">{entertainment.producer}</span>
        </div>
        <div>
            <span class="meta-label">RELEASED</span>
            <span class="meta-value">{entertainment.year}</span>
        </div>
        </div>

        <p class="desc">{entertainment.description}</p>
    </div>

    </div>
</section>

<style define:vars={{image: `url("${entertainment.imageUrl}")`}}>

	/* ---------- hero shell ---------- */
  .hero{
    position: relative;
    padding: 64px 32px;
    overflow: hidden;
  }
 
  .hero-inner{
    margin: 0 auto;
    display: grid;
    grid-template-columns: 35% 60%;
    gap: 5%;
    align-items: center;
  }
 
  /* ---------- 1:1 image ---------- */
  .art{
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 6px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(232,180,88,0.16), transparent 60%),
      linear-gradient(180deg, #24262A 0%, #1A1B1D 100%);
	background-image: var(--image);
	background-size: cover;
    border: 1px solid var(--hairline);
    box-shadow: 0 24px 48px -20px rgba(0,0,0,0.6);
  }
 
  /* ---------- content ---------- */
  .content{ min-width: 0; }
 
  .title{
    font-weight: 900;
    font-size: 2.5em;
    line-height: 1.15;
    color: #000000;
    margin: 0 0 12px;
  }
 
  .tags{
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
  }
 
  .tag{
    font-size: 0.75em;
    letter-spacing: 0.1em;
    color: #ffffff;
    background: #1c1c1c;
    border: 1px solid var(--hairline);
    padding: 5px 10px;
    border-radius: 5px;
  }
 
  .meta-grid{
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 18px 32px;
    padding: 18px 0;
    margin-bottom: 22px;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
 
  .meta-label{
    font-size: 0.75em;
    letter-spacing: 0.05em;
    color: #FFA500;
    display: block;
    margin-bottom: 5px;
  }
 
  .meta-value{
    font-size: 1em;
    color: #1c1c1c;
  }
 
  .desc{
    font-size: 1.2em;
    line-height: 1.5;
    color: #1c1c1c;
    margin: 0 0 28px;
  }
 
  .actions{
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 1100px){
    .hero{ padding: 40px 20px; }
    .hero-inner{
      grid-template-columns: 100%;
    }
    .art{ display:none; }
    .title{ font-size: 5em; }
    .meta-grid{ grid-template-columns: repeat(2, auto); }
  }
</style>


