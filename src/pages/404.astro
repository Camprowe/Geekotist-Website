---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { slugify } from '../utils/slugify.js';
---

<Layout 
	title="Geekotist by Camprowe - Everything you need to know about your favourite Games, Movies and TV Shows" 
	description="Geekotist is a Camprowe Production about the worlds you can't stop thinking about, the who, what, where, and when behind your favourite games, film, and TV."
>
	<Header />
	<main>
		<section class="about-hero">
            <div class="hero-glow"></div>
            <div class="hero-content">
                <span class="hero-subtitle">404</span>
                <h1 class="hero-title">Page Not <span>Found</span></h1>
            </div>
        </section>		
	</main>
	<Footer />
</Layout>

<style>	

	/* Hero Section */
	.about-hero {
		margin: 0 auto;
		position: relative;
		text-align: center;
		overflow: hidden;
		position: relative;
		height: 50vh;
		min-height: 750px;
		max-height: 800px;
		display: flex;
		align-items: center;
	}

	.hero-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, rgba(229, 9, 20, 0.15) 0%, rgba(0,0,0,0) 70%);
		z-index: 1;
		pointer-events: none;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1200px;
		margin: 0 auto;
	}

	.hero-subtitle {
		color: var(--accent-color);
		font-weight: 800;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 2px;
		margin-bottom: 1rem;
		display: inline-block;
	}

	.hero-title {
		font-size: 3.5rem;
		font-weight: 800;
		line-height: 1.1;
		margin: 0 0 1.5rem 0;
		letter-spacing: -1px;
	}

	.hero-title span {
		color: var(--accent-color);
	}
</style>